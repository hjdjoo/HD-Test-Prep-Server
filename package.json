{
  "name": "hd-test-prep-server",
  "version": "1.0.0",
  "description": "Server for HD Test Prep web app",
  "homepage": "",
  "bugs": {
    "url": "https://github.com/hjdjoo/HD-Test-Prep-Server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjdjoo/HD-Test-Prep-Server.git"
  },
  "license": "MIT",
  "author": "Darryl Joo",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx tsx --tsconfig tsconfig.json --watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "docker:dev": "docker compose -f docker-compose-dev.yaml up",
    "docker:start": "docker compose -f compose.yaml up -d",
    "docker:dev:stop": "docker compose -f docker-compose-dev.yaml down",
    "docker:stop": "docker compose -f compose.yaml down",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gen-types": "supabase gen types --lang=typescript --project-id \"ulkvsrwaqlwowvjsnjwu\" --schema public > database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@types/mailgun-js": "^0.22.18",
    "base64-arraybuffer": "^1.0.2",
    "change-case": "^5.4.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "nodemailer": "^7.0.11",
    "tsx": "^4.19.1",
    "type-fest": "^4.26.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0"
  }
}
