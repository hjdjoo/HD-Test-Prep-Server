{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "nodenext",
    // "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    /*Emission */
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Absolute import paths */
    "baseUrl": "./src",
    "paths": {
      "@/*": [
        "*"
      ],
      "@/utils": [
        "utils/*"
      ]
    }
  },
  "include": [
    "*",
    "src",
    "src/utils",
  ],
}